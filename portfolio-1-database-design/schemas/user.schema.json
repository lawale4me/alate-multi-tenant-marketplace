{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alate.marketplace/portfolio-1-database-design/schemas/user.schema.json",
  "title": "User Schema",
  "description": "Schema defining users (Vendor Admins, Seller Staff, Customers) with embedded address books and mandatory vendor scoping.",
  "type": "object",
  "required": ["_id", "vendorId", "email", "phone", "passwordHash", "role", "status"],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "MongoDB BSON ObjectId string"
    },
    "vendorId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Mandatory tenant boundary isolation key"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[1-9]\\d{1,14}$"
    },
    "passwordHash": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["SUPER_ADMIN", "VENDOR_ADMIN", "SELLER_ADMIN", "SELLER_STAFF", "CUSTOMER"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_VERIFICATION", "ACTIVE", "SUSPENDED", "DEACTIVATED"]
    },
    "isPhoneVerified": {
      "type": "boolean",
      "default": false
    },
    "profile": {
      "type": "object",
      "required": ["fullName"],
      "properties": {
        "fullName": { "type": "string", "minLength": 2 },
        "avatarUrl": { "type": "string", "format": "uri" },
        "marketingOptIn": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "addresses": {
      "type": "array",
      "description": "Embedded structured customer address book (no external geocoding required)",
      "items": {
        "type": "object",
        "required": ["_id", "contactName", "contactPhone", "addressLine", "city", "state"],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "contactName": { "type": "string" },
          "contactPhone": { "type": "string" },
          "addressLine": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "landmark": { "type": "string" },
          "isDefault": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
